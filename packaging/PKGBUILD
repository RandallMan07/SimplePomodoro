# Local snapshot package. Build with: python packaging/build.py
pkgname=simplepomodoro
pkgver=0.1.0
pkgrel=1
pkgdesc='Native GTK4 Pomodoro timer with radial countdown and schedule planning'
arch=('any')
license=('MIT')
depends=('python' 'python-gobject' 'python-cairo' 'gtk4>=4.12' 'libadwaita>=1.5' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'bash')
makedepends=('desktop-file-utils')
optdepends=('hyprland: floating and centered opening placement')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

check() {
    cd "$srcdir/$pkgname-$pkgver"
    PYTHONPATH=src /usr/bin/python -m unittest discover -s tests
    desktop-file-validate packaging/io.github.simplepomodoro.App.desktop
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -dm755 "$pkgdir/usr/share/$pkgname/src/simplepomodoro"
    install -m644 src/simplepomodoro/*.py "$pkgdir/usr/share/$pkgname/src/simplepomodoro/"
    install -Dm755 run.sh "$pkgdir/usr/share/$pkgname/run.sh"
    install -Dm755 packaging/simplepomodoro "$pkgdir/usr/bin/simplepomodoro"
    install -Dm644 assets/style.css "$pkgdir/usr/share/$pkgname/assets/style.css"
    install -Dm644 assets/io.github.simplepomodoro.App.png "$pkgdir/usr/share/$pkgname/assets/io.github.simplepomodoro.App.png"
    install -Dm644 assets/io.github.simplepomodoro.App.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.simplepomodoro.App.png"
    install -Dm644 packaging/io.github.simplepomodoro.App.desktop "$pkgdir/usr/share/applications/io.github.simplepomodoro.App.desktop"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 docs/icon-generation.md "$pkgdir/usr/share/doc/$pkgname/icon-generation.md"
    install -Dm644 docs/decisions.md "$pkgdir/usr/share/doc/$pkgname/decisions.md"
}
